{
  "//": "Composite indexes for every multi-field query the app runs. Firestore rejects an unindexed composite query at runtime, so each of these corresponds to a specific call in the repositories — the file is a list of the queries the app is allowed to make, not a guess.",
  "indexes": [
    {
      "//": "ProductRepository.fetchCatalogPage — the customer catalog, alphabetical.",
      "collectionGroup": "products",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "isActive", "order": "ASCENDING" },
        { "fieldPath": "nameLower", "order": "ASCENDING" }
      ]
    },
    {
      "//": "ProductRepository.fetchCatalogPage with a category filter.",
      "collectionGroup": "products",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "isActive", "order": "ASCENDING" },
        { "fieldPath": "categoryId", "order": "ASCENDING" },
        { "fieldPath": "nameLower", "order": "ASCENDING" }
      ]
    },
    {
      "//": "ProductRepository.search — prefix tokens over the active catalog.",
      "collectionGroup": "products",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "isActive", "order": "ASCENDING" },
        { "fieldPath": "searchTokens", "arrayConfig": "CONTAINS" }
      ]
    },
    {
      "//": "ProductRepository.findByBarcode — scanning, for both roles.",
      "collectionGroup": "products",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "barcode", "order": "ASCENDING" },
        { "fieldPath": "isActive", "order": "ASCENDING" }
      ]
    },
    {
      "//": "ProductRepository.watchLowStock — the dashboard's reorder list.",
      "collectionGroup": "products",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "isActive", "order": "ASCENDING" },
        { "fieldPath": "isLowStock", "order": "ASCENDING" },
        { "fieldPath": "stockQuantity", "order": "ASCENDING" }
      ]
    },
    {
      "//": "ProductRepository.fetchTopSelling — the customer home screen's trending strip.",
      "collectionGroup": "products",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "isActive", "order": "ASCENDING" },
        { "fieldPath": "unitsSoldTotal", "order": "DESCENDING" }
      ]
    },
    {
      "//": "CategoryRepository.watchActive/fetchActive — the customer category chip row.",
      "collectionGroup": "categories",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "isActive", "order": "ASCENDING" },
        { "fieldPath": "sortOrder", "order": "ASCENDING" }
      ]
    },
    {
      "//": "OrderRepository.watchForCustomer — a shopper's own history.",
      "collectionGroup": "orders",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "customerId", "order": "ASCENDING" },
        { "fieldPath": "createdAt", "order": "DESCENDING" }
      ]
    },
    {
      "//": "OrderRepository.watchActiveForCustomer — orders still being worked on.",
      "collectionGroup": "orders",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "customerId", "order": "ASCENDING" },
        { "fieldPath": "status", "order": "ASCENDING" },
        { "fieldPath": "createdAt", "order": "DESCENDING" }
      ]
    },
    {
      "//": "OrderRepository.watchOpenOrders — the owner's queue, oldest first.",
      "collectionGroup": "orders",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "status", "order": "ASCENDING" },
        { "fieldPath": "createdAt", "order": "ASCENDING" }
      ]
    },
    {
      "//": "OrderRepository.watchByStatus — the owner's status filter chips.",
      "collectionGroup": "orders",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "status", "order": "ASCENDING" },
        { "fieldPath": "createdAt", "order": "DESCENDING" }
      ]
    },
    {
      "//": "OrderRepository.fetchCompletedBetween — best sellers and reorder suggestions.",
      "collectionGroup": "orders",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "status", "order": "ASCENDING" },
        { "fieldPath": "completedAt", "order": "ASCENDING" }
      ]
    },
    {
      "//": "InventoryRepository.watchForProduct — one product's ledger.",
      "collectionGroup": "inventoryTransactions",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "productId", "order": "ASCENDING" },
        { "fieldPath": "createdAt", "order": "DESCENDING" }
      ]
    },
    {
      "//": "InventoryRepository.fetchByTypeBetween — damage or expiry in a period.",
      "collectionGroup": "inventoryTransactions",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "type", "order": "ASCENDING" },
        { "fieldPath": "createdAt", "order": "DESCENDING" }
      ]
    },
    {
      "//": "OwnerProductRepository.watchPriceHistory — one product's pricing trail.",
      "collectionGroup": "productPriceHistory",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "productId", "order": "ASCENDING" },
        { "fieldPath": "changedAt", "order": "DESCENDING" }
      ]
    },
    {
      "//": "FEFO consumption (placeOrder, adjustInventory auto-select) and OwnerProductRepository.watchBatches — oldest-expiring first.",
      "collectionGroup": "productBatches",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "productId", "order": "ASCENDING" },
        { "fieldPath": "expiryDate", "order": "ASCENDING" }
      ]
    }
  ],
  "fieldOverrides": []
}
