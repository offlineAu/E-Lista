rules_version = '2';

// E-Lista — Sari-Sari Store security rules.
//
// Design notes:
//  * Rules grant access per document, never per field. Anything a customer must not see
//    (cost prices, profit percentages, per-line cost snapshots) lives in a separate
//    owner-only document, never as a field on a customer-readable document.
//  * Anything financial is written by Cloud Functions with the Admin SDK, which bypasses
//    these rules. Client writes to orders, inventory, sales and prices are denied here so
//    that the server is the only authority.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------- helpers

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner() {
      return isSignedIn() && request.auth.token.role == 'owner';
    }

    function isCashier() {
      return isSignedIn() && request.auth.token.role == 'cashier';
    }

    // A cashier processes sales and sees stock levels, but never costs or profit — those
    // stay behind isOwner() alone, collection by collection below.
    function isOwnerOrCashier() {
      return isOwner() || isCashier();
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // ------------------------------------------------------------------ users
    //
    // A user document carries the role claim mirror plus profile information. The role
    // field itself is never writable from a client — it is set by a Cloud Function that
    // also sets the matching custom claim.

    match /users/{uid} {
      allow read: if isSelf(uid) || isOwner();
      allow create: if isSelf(uid)
                    && request.resource.data.role == 'customer'
                    && request.resource.data.uid == uid;
      allow update: if isSelf(uid)
                    && request.resource.data.role == resource.data.role
                    && request.resource.data.uid == resource.data.uid;
      allow delete: if false;
    }

    // --------------------------------------------------------------- products
    //
    // The public product document holds only what a customer is allowed to see: the
    // prices they pay, stock availability and descriptive fields.

    match /products/{productId} {
      allow read: if true;
      allow write: if false; // Cloud Functions only.

      // Cost price, pricing mode and profit percentage.
      match /private/{docId} {
        allow read: if isOwner();
        allow write: if false; // Cloud Functions only.
      }
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if false;
    }

    // ----------------------------------------------------------------- orders
    //
    // Customers read and list only their own orders. Order creation goes through the
    // placeOrder callable so that totals, stock and fees are derived server-side.

    match /orders/{orderId} {
      allow get: if isOwnerOrCashier() || isSelf(resource.data.customerId);
      allow list: if isOwnerOrCashier() || (isSignedIn() && request.auth.uid == resource.data.customerId);
      allow write: if false;

      // Per-line cost snapshot used for profit reporting.
      match /private/{docId} {
        allow read: if isOwner();
        allow write: if false;
      }
    }

    // ------------------------------------------------------------------ carts
    //
    // The cart is the one collection a customer genuinely owns. Prices in it are advisory
    // only — placeOrder recomputes everything from server state.

    match /carts/{uid} {
      allow read, write: if isSelf(uid);

      match /items/{itemId} {
        allow read, write: if isSelf(uid);
      }
    }

    // -------------------------------------------------------- owner-only data

    match /inventoryTransactions/{txId} {
      allow read: if isOwnerOrCashier();
      allow write: if false;
    }

    match /sales/{saleId} {
      allow read: if isOwner();
      allow write: if false;
    }

    // A cashier reads only their own shift's counts; the owner reviews every cashier's.
    match /cashCounts/{countId} {
      allow read: if isOwner() ||
                     (isCashier() && resource.data.cashierId == request.auth.uid);
      allow write: if false; // Cloud Functions only.
    }

    match /productPriceHistory/{entryId} {
      allow read: if isOwner();
      allow write: if false;
    }

    match /productBatches/{batchId} {
      allow read: if isOwnerOrCashier();
      allow write: if false;
    }

    // --------------------------------------------------------------- settings
    //
    // GCash convenience fee tiers are public: a customer has to be able to see the fee
    // that will be added to their order before they confirm it. Everything else under
    // settings (default profit percentage, cash rounding policy) is owner-only.

    match /settings/gcash_fees {
      allow read: if true;
      allow write: if false;
    }

    // The QR image itself lives in Storage; this just points at it. Public for the same
    // reason as the fee table: a customer paying by GCash has to be able to see it.
    match /settings/gcash_qr {
      allow read: if true;
      allow write: if false;
    }

    match /settings/{docId} {
      allow read: if isOwner();
      allow write: if false;
    }

    // ---------------------------------------------------------------- default

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
